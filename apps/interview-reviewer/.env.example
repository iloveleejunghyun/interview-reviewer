# Copy to .env (gitignored). EXPO_PUBLIC_* values are bundled into the app,
# so use keys created for this app only, with a spending cap in each console.
EXPO_PUBLIC_POSTHOG_KEY=

# Volcengine speech API key (single-key auth, sent as X-Api-Key).
# Console: https://console.volcengine.com/speech/app → 语音技术 → API Key管理
EXPO_PUBLIC_VOLCENGINE_ASR_API_KEY=

# Baidu Qianfan v2 API key (sent as Bearer).
# Console: https://console.bce.baidu.com/qianfan/ → API Key
EXPO_PUBLIC_QIANFAN_API_KEY=
